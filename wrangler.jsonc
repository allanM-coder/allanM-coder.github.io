{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allan-coaching-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}
